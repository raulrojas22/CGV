# Image/tag
CGV_IMAGE=cgv:1.0.0

# Exposed host port
CGV_PORT=3838

# Data locations on host (must exist)
CGV_ANNOTATIONS_DIR=./annotations
CGV_GENOMES_DIR=./genomes
CGV_GO_ANNOTATIONS_DIR=./go_annotations
CGV_CACHE_DIR=./cache

# Feedback email notifications (Resend API — https://resend.com)
# Put actual secrets in .env.local (never share that file).
# If FEEDBACK_RESEND_API_KEY is empty, email notifications are silently skipped.
FEEDBACK_RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=onboarding@resend.dev

# Optional tuning/logging
APP_DEBUG_LOGS=0
APP_PERF_TIMING=0
APP_FUTURE_MODE=sequential
APP_FUTURE_WORKERS=2
APP_HOMO_INITIAL_VISIBLE=1
APP_ORTHO_INITIAL_VISIBLE=1
APP_ORTHO_ALIGNED_FAST=1
APP_ORTHO_ALIGNED_KMER_K=8
# Startup prewarm — pre-indexes annotations so first search is fast.
# Recommended: set to 1 for production deployments.
APP_PREWARM_ON_START=0
APP_PREWARM_CLEAN=0
APP_PREWARM_BLOCK_START=0
