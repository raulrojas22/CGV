# Image/tag
CGV_IMAGE=cgv:1.0.0
# Imagen persistente con R, CRAN y Bioconductor. No se reconstruye en deploys
# de código; cambiarla sólo al actualizar docker/install_packages.R.
CGV_DEPS_IMAGE=cgv-deps:1.0.0

# Exposed host port
CGV_PORT=3838

# Data locations on host (must exist)
CGV_ANNOTATIONS_DIR=./annotations
CGV_GENOMES_DIR=./genomes
CGV_GO_ANNOTATIONS_DIR=./go_annotations
CGV_DATA_DIR=./data
CGV_CACHE_DIR=./cache
CGV_NCBI_DOWNLOADS_DIR=./ncbi_downloads
CGV_NCBI_CACHE_MAX_GB=50
# Anonymous administrative usage log; never blocks organism loading.
CGV_NCBI_USAGE_LOG_ENABLED=true

# ShinyProxy multi-user deployment. ShinyProxy itself is bound to 127.0.0.1
# by docker-compose.shinyproxy.yml; public traffic should enter through nginx
# or Cloudflare Tunnel. Use a high port to avoid NAS/system conflicts.
CGV_NGINX_PORT=18080
SHINYPROXY_PORT=8080
# ShinyProxy asks the host Docker daemon to create application containers, so
# these bind-mount sources must be absolute paths on that Docker host.
SP_ANNOTATIONS_DIR=/absolute/path/to/cgv/annotations
SP_GENOMES_DIR=/absolute/path/to/cgv/genomes
SP_GO_ANNOTATIONS_DIR=/absolute/path/to/cgv/go_annotations
SP_DATA_DIR=/absolute/path/to/cgv/data
SP_CACHE_DIR=/absolute/path/to/cgv/cache
SP_NCBI_DOWNLOADS_DIR=/absolute/path/to/cgv/ncbi_downloads
SP_CONTAINER_MEMORY=2g
SP_MAX_INSTANCES_PER_USER=10
SP_MAX_TOTAL_INSTANCES=10
SP_MAX_LIFETIME_MINUTES=120
SP_HEARTBEAT_RATE_MS=30000
SP_APP_PERF_TIMING=0
# Identifies the manual measurement set written under cache/perf_runs/.
# Use "antes" for the baseline and "despues" after an optimization.
SP_PERF_RUN_LABEL=manual

# Feedback email notifications (Resend API — https://resend.com)
# Put actual secrets in .env.local (never share that file).
# If FEEDBACK_RESEND_API_KEY is empty, the form reports that email delivery failed.
FEEDBACK_RESEND_API_KEY=
FEEDBACK_TO_EMAIL=cgvviewer@gmail.com
FEEDBACK_FROM_EMAIL="CGeV Feedback <feedback@cgvapp.com>"
# cgvapp.com is verified in Resend; send a branded confirmation copy to reporters.
FEEDBACK_SEND_RECEIPT=1
FEEDBACK_PUBLIC_URL=https://cgev.mobilomics.org
FEEDBACK_BACKUP_URL=https://cgvapp.com
FEEDBACK_LOGO_PATH=www/cgv-email-logo.png

# Background delivery of the same interactive reports generated by Share.
# The Resend API key can fall back to FEEDBACK_RESEND_API_KEY. The visible sender
# uses the verified cgvapp.com domain; replies go to the CGeV Gmail inbox.
APP_BACKGROUND_REPORTS_ENABLED=1
REPORT_RESEND_API_KEY=
REPORT_FROM_EMAIL="CGeV Reports <reports@cgvapp.com>"
REPORT_REPLY_TO_EMAIL=cgvviewer@gmail.com
REPORT_LOGO_PATH=www/cgv-email-logo.png
APP_BACKGROUND_REPORT_POLL_SECONDS=3
APP_BACKGROUND_REPORT_TIMEOUT_MINUTES=30
APP_BACKGROUND_REPORT_SNAPSHOT_MAX_MB=200
APP_BACKGROUND_REPORT_FUTURE_WORKERS=2
APP_BACKGROUND_REPORT_LASTZ_WORKERS=1
APP_BACKGROUND_EMAIL_ATTEMPTS=3

# Optional tuning/logging
APP_DEBUG_LOGS=0
APP_PERF_TIMING=0
APP_FUTURE_MODE=multisession
APP_FUTURE_WORKERS=2
# Total coordinated cap for ten large reusable R data caches. Web/container
# runtimes divide 384 MiB among the main process and configured future workers
# (128 MiB each with two workers). Desktop keeps 1024 MiB per process.
APP_MEMORY_CACHE_BUDGET_MB=384
# Web safety caps inside that coordinated allowance. Entry-count limits remain
# 1000 extracted genomic ranges and 1200 spliced transcript sequences. Desktop
# supplies 256/192 MiB respectively unless explicitly overridden.
APP_SEQ_EXTRACT_CACHE_MAX_MB=96
APP_SPLICED_SEQ_CACHE_MAX_MB=64
# LASTZ runs in a dedicated queue. Keep one concurrent job per web container;
# Desktop selects up to two automatically unless this value is overridden.
APP_LASTZ_WORKERS=1
# Shared filesystem semaphore across ShinyProxy sessions and the report worker.
# Set to 1 on the NAS so only one LASTZ process consumes CPU at a time.
APP_LASTZ_GLOBAL_WORKERS=1
APP_LASTZ_GLOBAL_QUEUE_WAIT_SECONDS=1800
APP_LASTZ_CACHE_MAX_ENTRIES=48
APP_LASTZ_CACHE_MAX_MB=128
APP_LASTZ_DISK_CACHE=1
APP_LASTZ_DISK_CACHE_MAX_MB=512
APP_LASTZ_DISK_CACHE_TTL_DAYS=30
# Static read-only analysis reports and reproducibility packages.
APP_SHARED_REPORTS_ENABLED=1
APP_SHARED_REPORT_MAX_MB=100
APP_SHARED_REPORT_STORAGE_GB=5
# Public origin used to build secret report URLs (no trailing slash).
CGV_PUBLIC_BASE_URL=https://cgvapp.com
# Managed automatically by the ShinyProxy deploy scripts from the exact image
# sha256 Id. Keep both empty for Desktop and direct Shiny deployments.
APP_ASSET_VERSION=
APP_STATIC_BASE_URL=
# Cross-Species accepts unambiguous local annotation matches by default.
# Set to 1 to require explicit one-to-one Ensembl Compara verification.
APP_ORTHO_REQUIRE_VERIFIED_ORTHOLOGY=0
# Transport/payload tuning for deployed Shiny sessions.
# Lower JSON precision and compact ggiraph SVG reduce WebSocket bytes sent to browsers.
APP_SHINY_JSON_DIGITS=12
APP_GIRAFE_COMPACT_SVG=1
APP_GIRAFE_SVG_DECIMALS=2
APP_GIRAFE_COMPACT_MIN_BYTES=2048
APP_ALIGNED_RIBBON_POINTS=25
APP_MULTIPIP_VISUAL_MERGE_FROM=350
# Run the synchronous ggiraph warm-up only after the first Shiny response so it
# cannot delay initial paint. Set the flag to 0 to disable it entirely.
APP_GENE_PLOT_RENDERER_PREWARM=1
APP_GENE_PLOT_RENDERER_PREWARM_DELAY_MS=1000
# Give the browser/user a grace window first; secondary warm-ups then yield while
# either search workflow is active and retry when the session is idle again.
APP_SECONDARY_WORK_INITIAL_DELAY_MS=2500
APP_SECONDARY_WORK_RETRY_MS=750
APP_STRING_WORKER_PREWARM=1
# Optional only: opening tabix eagerly may block the Shiny event loop on remote storage.
APP_TABIX_PROBE_ON_WARM=0
# Browser-side transport telemetry. Enable temporarily in production to measure
# HTTP resource bytes and Shiny/WebSocket message volume from the real browser.
APP_TRANSPORT_TIMING=0
APP_TRANSPORT_FLUSH_MS=5000
APP_ORTHO_LOOKUP_PARALLEL=1
APP_ORTHO_LOOKUP_PARALLEL_MIN_JOBS=2
APP_ORTHO_EXTERNAL_ALIAS=1
APP_ORTHO_LOCAL_PROGRESSIVE=0
APP_ORTHO_PREFER_MAIN_CACHE=1
APP_ORTHO_WORKER_PREWARM=0
APP_ORTHO_BACKGROUND_CACHE_WARM=0
APP_ORTHO_PREFLIGHT_SUGGESTIONS=0
APP_ORTHO_PREWARM_LOCAL_HANDLES=1
APP_FAST_ORGANISM_SYNC=1
# Group rapid Cross-Species organism-card clicks before preparing indexes.
APP_ORTHO_SELECTION_DEBOUNCE_MS=500
APP_IDLE_AUTOCOMPLETE_MIGRATION=0
APP_ANNOTATION_DISK_CACHE_MAX_FILES=192
APP_HOMO_RENDER_CHUNK_SIZE=1
APP_HOMO_AUTO_RENDER_DELAY_MS=120
APP_ORTHO_RENDER_CHUNK_SIZE=1
APP_ORTHO_AUTO_RENDER_MORE=1
APP_ORTHO_AUTO_RENDER_DELAY_MS=120
# Progressive rendering paints one primary card at a time in both workflows.
# The timeout below prevents a missing browser paint signal from stalling Cross-Species.
APP_ORTHO_FIRST_PAINT_TIMEOUT_MS=30000
APP_ORTHO_SERVER_RENDER_NUDGE=0
APP_ORTHO_SUSPEND_HIDDEN=1
# Future-release feature: keep disabled for the manuscript release.
APP_GENE_CATALOG_ENABLED=0
# Render each card once with its sequence composition and feature GC ready.
APP_HOMO_DEFER_SEQUENCE=0
APP_ORTHO_DEFER_SEQUENCE=0
APP_FOOTER_DEFER_SEQUENCE=0
APP_DEFER_FEATURE_GC=0
APP_HOMO_UPFRONT_ISOFORMS=0
APP_ORTHO_UPFRONT_ISOFORMS=0
APP_ISOFORM_RENDER_BATCH_SIZE=1
APP_ISOFORM_RENDER_BATCH_DELAY_MS=120
APP_ANALYTICS_PHASE2_DELAY_MS=0
APP_ANALYTICS_PHASE3_DELAY_MS=0
APP_HOMO_INITIAL_VISIBLE=1
APP_ORTHO_INITIAL_VISIBLE=1
APP_ORTHO_ALIGNED_FAST=1
# Runtime prewarm runs before every app container starts. Keep it off for
# ShinyProxy sessions; use docker/setup-prewarm.sh during deploy instead.
APP_PREWARM_ON_START=0
APP_PREWARM_CLEAN=0
APP_PREWARM_BLOCK_START=0
# Alias external lookup timeouts (seconds). Lower = faster but may miss results on slow networks.
APP_ALIAS_TIMEOUT_MYGENE=3
APP_ALIAS_TIMEOUT_NCBI=5
APP_ALIAS_TIMEOUT_UNIPROT=3
APP_ALIAS_TIMEOUT_ENSEMBL=4
APP_ALIAS_MAX_RETRIES=2
APP_ALIAS_RETRY_BUDGET_SEC=2
# Alias cache TTL (seconds). Cached results avoid repeated network calls.
APP_ALIAS_MEMORY_CACHE_MAX_ENTRIES=120
APP_ALIAS_MEMORY_CACHE_TTL_SEC=7200
APP_ALIAS_DISK_CACHE_MAX_ENTRIES=240
# Per-connection SQLite page-cache cap. Web defaults to 8 MiB; CGeV Desktop
# supplies 16 MiB. Values outside 1-64 MiB are clamped by the R runtime.
APP_ALIAS_SQLITE_CACHE_MB=8
# Process-local alias SQLite LRU. Desktop supplies 8; Web defaults to 4.
# Values outside 1-32 connections are clamped by the R runtime.
APP_ALIAS_SQLITE_MAX_CONNECTIONS=4
