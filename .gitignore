# macOS / editors
.DS_Store
.Rhistory
.Rproj.user/
.claude/
.codex_backups/
.qodo/
*.Rproj

# Secrets / local env
.env
.env.local
.Renviron

# Runtime / generated artifacts
cache/*
!cache/.gitkeep

# Large biological datasets live outside Git history.
# Keep only lightweight documentation and registries versioned.
annotations/*
!annotations/README.md
!annotations/registry.tsv

genomes/*
!genomes/README.md
!genomes/registry.tsv

go_annotations/*
!go_annotations/README.md
!go_annotations/registry.tsv

go_annotations/raw/*

# Local download scratch space
ncbi_downloads/*
!ncbi_downloads/.gitkeep

# Desktop Electron app
desktop/node_modules/
desktop/dist/
desktop/resources/r/
desktop/resources/bin/
desktop/resources/common-go/
desktop/resources/app-source-manifest.json
desktop/resources/demo-data/
desktop/resources/bundled-data/
desktop/dataset-packages/work/
desktop/dataset-packages/*.zip
desktop/dataset-packages/*.dmg
desktop/dataset-packages/*.pkg
desktop/dataset-packages/*.AppImage
desktop/dataset-packages/*.exe

# Keep lightweight desktop package metadata versioned.
!desktop/dataset-packages/*.manifest.json
!desktop/dataset-packages/catalog.json
